# Application
APP_NAME=DawaKhana
APP_ENV=development
APP_DEBUG=true
APP_PORT=5000

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=dawakahana
MYSQL_USER=dawakahana_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Database URL
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# Security
SECRET_KEY=change_this_secret_key
JWT_SECRET_KEY=change_this_jwt_secret_key

# Timezone
TZ=Asia/Kabul


